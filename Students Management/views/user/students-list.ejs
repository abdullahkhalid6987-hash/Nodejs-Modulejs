<%- include('../partials/head') %>
</head>

<body class="bg-gray-50 text-gray-800">

  <!-- Navbar -->
  <%- include('../partials/nav') %>
  <!-- Main -->
  <main class="max-w-5xl mx-auto px-6 py-12">

    <!-- Page Heading -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">
        Students
      </h1>

      <p class="mt-2 text-gray-500">
        Here is the list of all students.
      </p>
    </div>


    <!-- Students Grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% students.forEach(student => { %>
      <!-- Student Card -->
     <div class="bg-white border rounded-lg p-5">

        <div class="flex items-center gap-4">

          <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-semibold">
              <% const initials = student.name.split(' ').map(name => name[0].toUpperCase())
            const display = initials.length === 1 ? initials[0][0] : initials[0][0]+initials[initials.length -1 ][0]  %>
            <%= display %>
          </div>

          <div>
            <h2 class="font-semibold text-gray-900">
              <%= student.name %>
            </h2>

            <p class="text-sm text-gray-500">
              <% student.major %>
            </p>
          </div>

        </div>

        <div class="border-t mt-5 pt-4 space-y-2 text-sm">

          <div class="flex justify-between">
            <span class="text-gray-500">Age</span>
            <span><%= student.age %></span>
          </div>

          <div class="flex justify-between">
            <span class="text-gray-500">Grade</span>
            <span class="font-medium text-green-600"><%= student.grade %></span>
          </div>

        </div>

         <!-- Show Details Button -->
      <a
        href="/student-detail/<%= student.id %>"
        class="block w-full text-center bg-indigo-600 text-white px-3 mt-5 py-2 rounded-md text-sm hover:bg-indigo-700"
      >
        Show Details
      </a>

         <form
        action="/best-students/<%= student.id %>"
        method="POST"
        class="flex-1"
      >
        <button
          type="submit"
          class="w-full bg-green-600 text-white px-3 mt-3 py-2 rounded-md text-sm hover:bg-green-700"
        >
          Add to Best Student List
        </button>
      </form>

      </div>

      <% }) %>
    </div>

  </main>


  <!-- Footer -->
 <%- include('../partials/footer') %>

</body>
</html>