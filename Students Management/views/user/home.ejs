<%- include('../partials/head') %>
</head>

<body class="bg-gray-50 text-gray-800">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <!-- Main -->
  <main class="max-w-5xl mx-auto px-6 py-20">

    <div class="max-w-2xl">

      <p class="text-sm font-medium text-indigo-600 mb-3">
        Student Management System
      </p>

      <h1 class="text-4xl font-bold text-gray-900">
        Welcome to StudentApp
      </h1>

      <p class="mt-4 text-gray-600 leading-7">
        A simple application for managing students,
        viewing their information, and keeping track of
        the best performing students.
      </p>

      <div class="mt-7 flex gap-3">

        <a
          href="/students"
          class="bg-indigo-600 text-white px-5 py-2.5 rounded-md hover:bg-indigo-700"
        >
          View Students
        </a>

        <a
          href="/admin/add-student"
          class="border border-gray-300 bg-white px-5 py-2.5 rounded-md hover:bg-gray-100"
        >
          Add Student
        </a>

      </div>

    </div>


    <!-- Simple Cards -->
    <div class="grid md:grid-cols-3 gap-5 mt-16">

      <div class="bg-white border rounded-lg p-6">
        <h2 class="font-semibold text-lg">
          Students
        </h2>

        <p class="text-gray-500 text-sm mt-2">
          View the complete list of students.
        </p>

        <a
          href="/students"
          class="inline-block mt-4 text-sm text-indigo-600 hover:underline"
        >
          View students →
        </a>
      </div>

    </div>

  </main>


  <!-- Footer -->
  <%- include('../partials/footer') %>

</body>
</html>