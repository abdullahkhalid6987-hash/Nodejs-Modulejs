<%- include('../partials/head') %>
</head> 
<body class="bg-gray-50 text-gray-800"> <!-- Navbar -->

<%- include('../partials/nav') %>

<!-- Main --> <main class="max-w-5xl mx-auto px-6 py-12">
<!-- Page Heading -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">

  <div>
    <p class="text-sm font-medium text-indigo-600 mb-2">
      Student Management
    </p>

    <h1 class="text-3xl font-bold text-gray-900">
      Admin Dashboard
    </h1>

    <p class="mt-2 text-gray-500">
      Manage your students and their information.
    </p>
  </div>

  <!-- Add Student Button -->
  <a
    href="/admin/add-student"
    class="inline-flex items-center justify-center bg-indigo-600 text-white px-5 py-2.5 rounded-md hover:bg-indigo-700"
  >
    + Add New Student
  </a>

</div>


<!-- Students Grid -->
<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

  <% students.forEach(student =>{ %>
  <!-- Student Card -->
  <div class="bg-white border rounded-lg p-5">

    <div class="flex items-center gap-4">

      <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-semibold">
        <% const initials = student.name.split(" ").map(name => name[0].toUpperCase()) 
        const display = initials.length === 1 ? initials[0] : initials[0][0]+initials[initials.length -1][0] %>
        <%= display %>
      </div>

      <div>
        <h2 class="font-semibold text-gray-900">
          <%= student.name %>
        </h2>

        <p class="text-sm text-gray-500">
          <%= student.major %>
        </p>
      </div>

    </div>

    <div class="border-t mt-5 pt-4 space-y-2 text-sm">

      <div class="flex justify-between">
        <span class="text-gray-500">Age</span>
        <span><%= student.age %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-gray-500">Grade</span>
        <span class="font-medium text-green-600"><%= student.grade %></span>
      </div>

    </div>

        <a
        href="/student-detail/<%= student.id %>"
        class="block w-full text-center bg-indigo-600 text-white px-3 mt-5 py-2 rounded-md text-sm hover:bg-indigo-700"
      >
        Show Details
      </a>

    <!-- Admin Actions -->
    <div class="border-t mt-5 pt-4 flex gap-2">

      <a
        href="/admin/add-student/<%= student.id %>?edit=true"
        class="flex-1 text-center border border-gray-300 bg-white text-gray-700 px-3 py-2 rounded-md text-sm hover:bg-gray-100"
        method="GET"
      >
        Edit
      </a>

      <form
        action="/admin/delete-student/<%= student.id %>"
        method="POST"
        class="flex-1"
      >
        <button
          type="submit"
          class="w-full bg-red-600 text-white px-3 py-2 rounded-md text-sm hover:bg-red-700"
        >
          Remove
        </button>
      </form>

    </div>

  </div>

  <% }) %>
  
</div>

</main> <!-- Footer -->

<%- include('../partials/footer') %>

</body> </html>