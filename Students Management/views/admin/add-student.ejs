<%- include('../partials/head') %>

</head> <body class="bg-gray-50 text-gray-800">

<%- include('../partials/nav') %>

<main class="max-w-3xl mx-auto px-6 py-12">
<!-- Page Heading -->
<div class="mb-8">
  <p class="text-sm font-medium text-indigo-600 mb-2">
    Student Management
  </p>

  <h1 class="text-3xl font-bold text-gray-900">
    <%= edit ? 'Edit Student' : 'Add New Student' %>
  </h1>

  <p class="mt-2 text-gray-500">
    Enter the student's information below.
  </p>
</div>

<!-- Form Card -->
<div class="bg-white border rounded-lg p-6 shadow-sm">

  <form action="<% edit ? '/admin/edit-student' : '/admin/add-student' %>" method="POST">

    <!-- Student Id -->

    <input type="hidden" name="id" value="<%= edit ? student.id: '' %>">

    <!-- Student Name -->
    <div class="mb-5">
      <label
        for="name"
        class="block text-sm font-medium text-gray-700 mb-2"
      >
        Student Name
      </label>

      <input
        type="text"
        id="name"
        name="name"
        value = "<%= edit ? student.name : '' %>"
        placeholder="e.g. Ahmed Khan"
        required
        class="w-full border border-gray-300 rounded-md px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
      >
    </div>

    <!-- Major -->
    <div class="mb-5">
      <label
        for="major"
        class="block text-sm font-medium text-gray-700 mb-2"
      >
        Major
      </label>

      <input
        type="text"
        id="major"
        name="major"
        value = "<%= edit ? student.major : '' %>"
        placeholder="e.g. Computer Science"
        required
        class="w-full border border-gray-300 rounded-md px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
      >
    </div>

    <!-- Age -->
    <div class="mb-5">
      <label
        for="age"
        class="block text-sm font-medium text-gray-700 mb-2"
      >
        Age
      </label>

      <input
        type="number"
        id="age"
        name="age"
         value = "<%= edit ? student.age : ' ' %>"
        min="1"
        max="100"
        placeholder="e.g. 20"
        required
        class="w-full border border-gray-300 rounded-md px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
      >
    </div>

    <!-- Grade -->
    <div class="mb-8">
      <label
        for="grade"
        class="block text-sm font-medium text-gray-700 mb-2"
      >
        Grade
      </label>

 <select
  id="grade"
  name="grade"
  required
  class="w-full border border-gray-300 rounded-md px-4 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
>
  <option value="" <%= !edit ? 'selected' : '' %> disabled>
    Select a grade
  </option>

  <option value="A+" <%= edit && student.grade === 'A+' ? 'selected' : '' %>>A+</option>
  <option value="A"  <%= edit && student.grade === 'A'  ? 'selected' : '' %>>A</option>
  <option value="A-" <%= edit && student.grade === 'A-' ? 'selected' : '' %>>A-</option>
  <option value="B+" <%= edit && student.grade === 'B+' ? 'selected' : '' %>>B+</option>
  <option value="B"  <%= edit && student.grade === 'B'  ? 'selected' : '' %>>B</option>
  <option value="B-" <%= edit && student.grade === 'B-' ? 'selected' : '' %>>B-</option>
  <option value="C+" <%= edit && student.grade === 'C+' ? 'selected' : '' %>>C+</option>
  <option value="C"  <%= edit && student.grade === 'C'  ? 'selected' : '' %>>C</option>
  <option value="C-" <%= edit && student.grade === 'C-' ? 'selected' : '' %>>C-</option>
  <option value="D"  <%= edit && student.grade === 'D'  ? 'selected' : '' %>>D</option>
  <option value="F"  <%= edit && student.grade === 'F'  ? 'selected' : '' %>>F</option>
</select>

    </div>

    <!-- Buttons -->
    <div class="flex items-center justify-end gap-3">

      <a
        href="/admin/students"
        class="px-5 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-md hover:bg-gray-100"
      >
        Cancel
      </a>

      <button
        type="submit"
        class="px-5 py-2.5 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
      >
        Add Student
      </button>

    </div>

  </form>

</div>

</main>

<%- include('../partials/footer') %>

</body> </html>