<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
</head>

<body class="w-full min-h-screen bg-[url('/background.jpg')] bg-cover bg-no-repeat bg-center text-blue-100">

    <!-- Navigation -->
    <nav class="flex">
        <ul class="flex mx-auto space-x-5 mt-6">

            <% if(isLoggedIn) { %>

                <li
                    class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5">
                    <a href="/logout">LogOut</a>
                </li>

                <% } else { %>

                    <li
                        class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5">
                        <a href="/signup">SignUp</a>
                    </li>

                    <li
                        class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5">
                        <a href="/login">Login</a>
                    </li>

                    <% } %>

        </ul>
    </nav>


    <!-- Page Heading -->
    <h1 class="text-5xl text-center mt-10 mb-10">
        User Management
    </h1>


    <!-- Users -->

        <div class="flex justify-center mx-auto backdrop-blur-sm p-6 w-11/12 md:w-1/2 rounded-2xl border border-blue-100/20 bg-white/5 my-24">

            <div class="flex flex-col items-center space-y-">

                <!-- Avatar -->
                <div class="bg-blue-400/30 w-20 h-20 rounded-full flex items-center justify-center">
                    <span class="text-5xl">
                        <%= user.firstName[0].toUpperCase() %>
                    </span>
                </div>


                <!-- User Information -->
                <div class="w-full space-y-2 text-lg">

                    <div>
                        <span class="font-medium">Name:</span>
                        <%= user.firstName %>
                            <%= user.lastName || '' %>
                    </div>

                    <div>
                        <span class="font-medium">Email:</span>
                        <%= user.email %>
                    </div>

                    <div>
                        <span class="font-medium">Gender:</span>
                        <%= user.gender %>
                    </div>

                </div>


                <!-- Role -->
                <form action="/changeRole/:<%= user._id %>" method="POST">
                    <div class="w-full pt-3 border-t border-blue-100/20">
    
                        <label for="role-<%= user._id %>" class="block text-lg font-medium mb-2">
                            Role
                        </label>
    
                        <select id="role-<%= user._id %>" name="role"
                            class="w-full bg-blue-950/40 border border-blue-100/30 rounded-xl px-6 py-3 text-blue-100 outline-none focus:border-blue-100/70 focus:ring-1 focus:ring-blue-100/50">
    
                            <option value="user" <%=user.role==='user' ? 'selected' : '' %>>
                                User
                            </option>
    
                            <option value="employee" <%=user.role==='employee' ? 'selected' : '' %>>
                                Employee
                            </option>
    
                        </select>
    
                    </div>
                <div class="w-fit text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5 mt-3"><button type="submit">Change Role</a></div>
                </form>
            </div>

        </div>



</body>

</html>