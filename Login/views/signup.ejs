<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Tailwind CSS Play CDN -->
  <link rel="stylesheet" href="output.css">
</head>
<body class="w-full bg-[url('./background.jpg')] bg-cover bg-no-repeat bg-center text-blue-100">
    <nav class="flex ">
        <ul class="flex  mx-auto space-x-5 mt-6">
            <li class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5"><a href="/signup">SignUp</a></li>
            <li class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5"><a href="/login">Login</a></li>
        </ul>
    </nav>
    <div class="flex items-center mx-auto justify-center backdrop-blur-sm w-fit mt-10 mb-10 p-5 rounded-2xl border border-blue-100/20">
        <form class="flex flex-col  items-center justify-center p-3 space-y-3" action="/signup" method="POST">
            <h1 class="text-center text-3xl p-3 mb-5">SignUp</h1>
            <% if(errors.length > 0){ %>
                <div class=" text-red-400/80 mb-3">
                <h1 class="text-xl text-center mb-1">Errors</h1>
            <ul>
                <% errors.forEach(error => { %>
                    <li class="list-disc">
                        <%= error %>
                    </li>
                <% }) %>
            </ul>
            </div>
            <% } %>
            <div>     
                <input type="text" name="firstName" placeholder="First Name" class="py-3 w-full md:w-auto mb-3 md:mb-auto px-2 border border-blue-100 rounded-xl mr-3" value="<%= oldInput.firstName ? oldInput.firstName : ''  %>">
                <input type="text" name="lastName" placeholder="Last Name" class="py-3 w-full md:w-auto px-2 border border-blue-100 rounded-xl" value="<%= oldInput.lastName ? oldInput.lastName : ''%>"  >
            </div>
              <input type="email" name="email" placeholder="Enter your email" class="py-3 px-2 border border-blue-100 rounded-xl w-full">
              <input type="password" name="password" placeholder="Password" class="py-3 px-2 border border-blue-100 rounded-xl w-full">
              <input type="password" name="confirmPassword" placeholder="Confirm Password" class="py-3 px-2 border border-blue-100 rounded-xl w-full">
            <div class="flex items-center space-x-2">
                <input type="radio" name="gender" value="male" class="h-4 w-4" <%= oldInput.gender === 'male' ? 'checked' : ' '%>>
                <label for="male" class="text-center">Male</label>
                <input type="radio" name="gender" value="female" class="h-4 w-4" <%= oldInput.gender === 'female' ? 'checked' : ' '%>>
                <label for="female">Female</label>
            </div>
            <button type="submit" class="w-full py-4 border border-blue-100 rounded-4xl hover:underline hover:underline-offset-8 hover:bg-white/5 cursor-pointer transition-transform duration-100 hover:scale-105">SignUp</button>
            <p>Already have an account? <a class="cursor-pointer hover:underline">Login</a></p>
        </form>
    </div>
</body>
</html>
