<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Tailwind CSS Play CDN -->
  <link rel="stylesheet" href="output.css">
</head>
<body class="w-full bg-[url('./background.jpg')] bg-cover bg-no-repeat bg-center text-blue-100">
    <nav class="flex ">
        <ul class="flex  mx-auto space-x-5 mt-6">
            <li class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5"><a href="/signup">SignUp</a></li>
            <li class="w-24 text-center cursor-pointer text-xl border border-blue-100 px-3 py-3 rounded-2xl backdrop-blur-sm hover:underline hover:underline-offset-8 hover:bg-white/5"><a href="/login">Login</a></li>
        </ul>
    </nav>
    <div class="flex items-center mx-auto justify-center w-fit backdrop-blur-sm mt-10 mb-10 p-5 rounded-2xl border border-blue-100/20">
        <form class="flex flex-col items-center justify-center space-y-3" action="/login" method="POST">
             <% if(errors.length > 0){ %>
                <div class=" text-red-400/80 mb-3">
                <h1 class="text-xl text-center mb-1">Errors</h1>
            <ul>
                <% errors.forEach(error => { %>
                    <li class="list-disc">
                        <%= error %>
                    </li>
                <% }) %>
            </ul>
            </div>
            <% } %>
            <h1 class="text-center text-3xl p-3 mb-5">LogIn</h1>
              <input type="email" name="email" placeholder="Enter your email" class="py-3 px-2 border border-blue-100 rounded-xl w-100" value="<%= oldInput.email ? oldInput.email : '' %>">
              <input type="password" name="password" placeholder="Password" class="py-3 px-2 border border-blue-100 rounded-xl w-full">
            <button type="submit" class="w-full py-4 border border-blue-100 rounded-4xl hover:underline hover:underline-offset-8 hover:bg-white/5 cursor-pointer transition-transform duration-100 hover:scale-105">Login</button>
        </form>
    </div>
</body>
</html>
