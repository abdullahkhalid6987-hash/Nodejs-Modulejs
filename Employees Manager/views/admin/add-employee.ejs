<%- include('../partials/head') %>
</head>
<body class="bg-gray-50 font-sans text-gray-800 antialiased p-8">
    <form action="employees" class="bg-white border border-gray-200 rounded-xl p-6 max-w-xl mx-auto space-y-4" method="post">
        <h2 class="text-lg font-bold">Add Employee</h2>
        <div>
            <label class="block text-sm font-medium text-gray-700">Full Name</label>
            <input type="text" name="name" placeholder="John Doe" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700">Role</label>
            <input type="text" name="role" placeholder="Software Developer" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <input type="email" name="email" placeholder="Software Developer" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div class="flex justify-end gap-3">
            <a href="employees" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700">Cancel</a>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium">Save</button>
        </div>
    </form>
</body>
</html>